{
  "description": "ClaudeCodeToaster lifecycle sound hooks: play success / fail / abort sounds when a task turn ends (designed for bypass-permissions auto mode).",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/index.js\" hook Stop",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/index.js\" hook StopFailure",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/index.js\" hook PostToolUseFailure",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
