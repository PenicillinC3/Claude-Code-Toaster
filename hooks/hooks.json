{
  "description": "ClaudeCodeToaster lifecycle sound hooks: play success / fail / abort sounds when a task turn ends, and a notify sound on permission prompts (Claude blocked waiting for approval).",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/index.js\" hook Stop",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/index.js\" hook StopFailure",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/index.js\" hook PostToolUseFailure",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/index.js\" hook Notification permission_prompt",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
